# File: .env.example
# Purpose: Optional shell environment template; the application does not auto-load it.
# Maintainer: sunshine-engineer
# Modified: 2026-10-23
# Copy to ignored .env, edit privately, then run: set -a; source .env; set +a
# Quote shell values. Never commit real keys or database URLs containing passwords.

# CLI live evaluation/benchmark credential. Local/reviewer Chat uses its sidebar;
# hosted Chat reads deployment/secrets.example.toml via .streamlit/secrets.toml.
GROQ_API_KEY=''

# local | reviewer | hosted. Reviewer mode permits bundled synthetic SQLite only.
ASSISTANT_DEPLOYMENT='local'

# Optional local SQLite telemetry database. Unset disables persistent counters.
# ASSISTANT_TELEMETRY_PATH='.telemetry/requests.db'

# Integration tests only: disposable administrator databases, never production.
# URLs must use SQLAlchemy escaping for special characters in credentials.
# TEST_POSTGRES_ADMIN_URL='postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/testdb'
# TEST_MYSQL_ADMIN_URL='mysql+mysqlconnector://USER:PASSWORD@127.0.0.1:3306/testdb'
